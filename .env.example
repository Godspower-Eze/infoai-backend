HTTP_ADDRESS=:8080
# Empty means the API trusts only the direct TCP peer. Behind trusted proxies,
# list their CIDR ranges and ensure the API is not directly internet-accessible.
TRUSTED_PROXY_CIDRS=
DATABASE_URL=postgres://infoai:infoai@localhost:5432/infoai?sslmode=disable
API_ORIGIN=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_X_REDIRECT_URL=http://localhost:3000/settings/integrations
COOKIE_SECURE=false
SESSION_LIFETIME=720h
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
X_CLIENT_ID=replace-me
X_CLIENT_SECRET=replace-me
X_CALLBACK_URL=http://localhost:8080/api/v1/integrations/x/callback
# Private local media objects; use a persistent volume in production.
MEDIA_STORAGE_ROOT=var/media
# JSONL operational errors are mode 0600 and rotate by size.
ERROR_LOG_PATH=var/log/infoai/errors.jsonl
ERROR_LOG_MAX_BYTES=10485760
ERROR_LOG_RETAINED_FILES=5
